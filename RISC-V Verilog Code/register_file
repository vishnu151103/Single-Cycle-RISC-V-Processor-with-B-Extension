module reg_file(
    input clk, wr_en,
    input [4:0] rs1_addr, rs2_addr, rd_addr,
    input [31:0] rd_data,
    output [31:0] rs1, rs2
);

reg [31:0] register [31:0];
integer i;

initial begin
    for (i = 0; i < 32; i = i + 1)
        register[i] = 32'd0;
end

assign rs1 = (rs1_addr == 0) ? 0 : register[rs1_addr];
assign rs2 = (rs2_addr == 0) ? 0 : register[rs2_addr];

always @(posedge clk) begin
    if (wr_en == 1 && rd_addr != 0)
        register[rd_addr] <= rd_data;
end

endmodule
